{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "[Article headline, ≤ 110 characters]",
  "description": "[Summary]",
  "image": [ "https://example.com/article-image-1200.jpg" ],
  "datePublished": "[YYYY-MM-DD]",
  "dateModified": "[YYYY-MM-DD]",
  "author": {
    "@type": "Person",
    "name": "[Author name]",
    "jobTitle": "[Role or credential]",
    "url": "https://example.com/about/[author]"
  },
  "publisher": {
    "@type": "Organization",
    "name": "[Brand]",
    "logo": { "@type": "ImageObject", "url": "https://example.com/logo-512.png" }
  },
  "mainEntityOfPage": "https://example.com/[path]"
}
