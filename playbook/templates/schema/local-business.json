{
  "@context": "https://schema.org",
  "@type": "[LocalBusiness subtype, e.g. ProfessionalService, Restaurant, Dentist, Store]",
  "@id": "https://example.com/#business",
  "name": "[Official name]",
  "url": "https://example.com/",
  "image": "https://example.com/storefront-or-team.jpg",
  "logo": "https://example.com/logo-512.png",
  "description": "[One-sentence description]",
  "telephone": "[+1-555-555-5555]",
  "email": "[hello@example.com]",
  "priceRange": "[$$]",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "[123 Main St]",
    "addressLocality": "[City]",
    "addressRegion": "[ST]",
    "postalCode": "[00000]",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": 0.0, "longitude": 0.0 },
  "areaServed": [ { "@type": "City", "name": "[City]" } ],
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"], "opens": "09:00", "closes": "17:00" }
  ],
  "sameAs": [ "[Google Business Profile URL]", "[Instagram URL]" ]
}
